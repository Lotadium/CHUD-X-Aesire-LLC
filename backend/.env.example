# Copy this file to .env (git-ignored) and fill in your own values. Never commit .env.
# The tests do not need this file: they use fake Brave settings (test/setup.ts).

# Required: Neon connection string (Neon console -> project -> Connect, pick your branch).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required: Brave Search API, used by website discovery and the refresh.
BRAVE_API_KEY=your-brave-api-key
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# Optional: port for `npm run local` (default 8787).
PORT=8787

# Optional: comma-separated front-end origins allowed to call the API (default: any origin, for development).
CORS_ORIGIN=http://localhost:5173

# Optional: stop web searches after this many per month (default: no limit).
WEB_SEARCH_MONTHLY_LIMIT=

# Optional: User-Agent sent by the contact crawler (default: AesireCHUDBot/1.0 (data refresh for Aesire LLC)).
CRAWLER_USER_AGENT=

# Optional: how long one refresh request may run, in milliseconds (default 20000).
REFRESH_TIME_BUDGET_MS=
