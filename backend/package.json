{
  "name": "chud-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Client Tracking Information app (Neon Function + Postgres)",
  "scripts": {
    "dev": "neon dev",
    "local": "node --env-file=.env functions/local.ts",
    "deploy": "neon deploy",
    "typecheck": "tsc --noEmit",
    "test:contact": "node --experimental-strip-types \"test/crawler.live.ts\"",
    "test": "node --import ./test/setup.ts --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neon/config": "^1.9.2",
    "@neon/functions": "^0.11.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
